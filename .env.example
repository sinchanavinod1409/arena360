# Server & Application Configuration
APP_URL="http://localhost:3000"
PORT="3000"
JWT_SECRET="replace-with-strong-random-32-byte-secret"

# Relational SQLite (Container / Local) or PostgreSQL (Production)
SQLITE_DB_PATH="./data/playnex.db"
# For Vercel + Supabase / PostgreSQL deployments (see db/schema.sql)
POSTGRES_HOST="your-db-host"
POSTGRES_DB="playnex"
POSTGRES_USER="playnex_app"
POSTGRES_PASSWORD="your-db-password"

# Razorpay Payment Gateway (Test Mode by default if omitted)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_test_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"

# Notification Providers (Optional — in-app notifications always active)
SMTP_HOST=""
SMTP_USER=""
SMTP_PASS=""
SMS_PROVIDER_KEY=""

# Gemini AI (Injected automatically by AI Studio if used)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
